{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "deployment_id", "backend", "image_digest", "model_id", "created_at"],
  "properties": {
    "schema_version": {"type": "integer"},
    "deployment_id": {"type": "string", "minLength": 8},
    "backend": {"enum": ["hyperv-cpu", "native-linux-gpu"]},
    "image_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "model_id": {"type": "string"},
    "created_at": {"type": "string"}
  }
}

